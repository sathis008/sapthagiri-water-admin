{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2022",
    "lib": ["ES2022"],

    /* Module Settings */
    "module": "CommonJS",

    /* Project Structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    /* Node Support */
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Output */
    "sourceMap": true,
    "removeComments": false,

    /* Performance */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* JSON Imports */
    "resolveJsonModule": true,

    /* Misc */
    "isolatedModules": true
  },

  "include": ["src/**/*"],

  "exclude": ["node_modules", "dist"]
}
